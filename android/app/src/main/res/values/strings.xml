<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">奶蛋桌宠</string>
    <string name="notif_title">奶蛋还在桌面上</string>
    <string name="notif_text">点按可拖动，单击会弹一下</string>
    <string name="intro">一只抱着枕头的黄色小玩偶。需要「显示在其他应用上层」权限才能出现在屏幕上。</string>
    <string name="btn_start">启动桌宠</string>
    <string name="btn_walk">让它走动</string>
    <string name="btn_idle">让它停下</string>
    <string name="btn_quit">退出</string>
    <string name="origin_hint">vivo / iQOO 的 OriginOS 会主动杀后台：请在「设置 → 应用与权限 → 奶蛋桌宠」里把自启动打开，并把耗电行为设为「允许后台高耗电 / 无限制」，否则桌宠几分钟后就会消失。</string>
</resources>
